# ---- Frigate -------------------------------------------------------------
# Base URL of the Frigate instance (no trailing slash).
FRIGATE_URL=http://192.168.1.50:5000
# Camera name exactly as it appears in Frigate's config.yml.
FRIGATE_CAMERA_NAME=fridge

# ---- MQTT ----------------------------------------------------------------
MQTT_HOST=192.168.1.50
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# ---- Trigger behaviour ---------------------------------------------------
# events  -> subscribe to frigate/events, act on type=="end" in ZONE_NAME
# motion  -> subscribe to frigate/{FRIGATE_CAMERA_NAME}/motion, pull the
#            recording for the ON..OFF window instead of an event clip.
TRIGGER_MODE=events
ZONE_NAME=fridge_door

# ---- Vision --------------------------------------------------------------
FRAME_COUNT=6
CONFIDENCE_THRESHOLD=0.75
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Supabase ------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key: this process writes server-side and bypasses RLS.
SUPABASE_SERVICE_KEY=eyJ...

# ---- Local storage -------------------------------------------------------
# Every processed event writes its frames + model output here so the clip can
# be replayed later without standing at the fridge.
CAPTURES_DIR=./captures
