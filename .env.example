# ---- Camera --------------------------------------------------------------
# Password for the Reolink user you made for Frigate. docker-compose.yml passes
# this to Frigate, and frigate/config.yml refers to it as
# {FRIGATE_RTSP_PASSWORD}, so the password is never written into config.yml.
FRIGATE_RTSP_PASSWORD=your_camera_password

# ---- Frigate -------------------------------------------------------------
# Base URL of the Frigate instance (no trailing slash). Port 5000, not 8971 --
# 8971 is the browser UI and requires a login.
# Ignored under docker compose, which sets this to http://frigate:5000.
FRIGATE_URL=http://192.168.1.50:5000
# Camera name exactly as it appears in Frigate's config.yml.
FRIGATE_CAMERA_NAME=fridge

# ---- MQTT ----------------------------------------------------------------
# Ignored under docker compose, which sets this to the `mqtt` service.
MQTT_HOST=192.168.1.50
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# ---- Trigger behaviour ---------------------------------------------------
# events  -> subscribe to frigate/events, act on type=="end" in ZONE_NAME
# motion  -> subscribe to frigate/{FRIGATE_CAMERA_NAME}/motion, pull the
#            recording for the ON..OFF window instead of an event clip.
TRIGGER_MODE=events
ZONE_NAME=fridge_door

# ---- Vision --------------------------------------------------------------
FRAME_COUNT=6
CONFIDENCE_THRESHOLD=0.75
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Supabase ------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key: this process writes server-side and bypasses RLS.
SUPABASE_SERVICE_KEY=eyJ...

# ---- Local storage -------------------------------------------------------
# Every processed event writes its frames + model output here so the clip can
# be replayed later without standing at the fridge. Under docker compose this
# is /captures inside the container, bind-mounted to ./captures on the host.
CAPTURES_DIR=./captures
